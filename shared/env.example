# shared/env.example - env.example을 복사하여 .env 생성
# OperatingEnv 구성 시 .env는 shared 폴더에만 두고, SSL 경로는 ecosystem에서 절대경로로 맞춘다.
# 우선순위: 프로세스 환경변수 > 이 파일 > 스크립트 기본값
#
# 스크립트가 읽는 공통 값. 다른 앱/현장으로 옮길 때 여기만 바꾸면 된다.
# PM2_APP_NAME 이 프로세스 이름이다. 비우면 web-server.
# 제품별 프로세스 이름은 빌드할 때 갈라지고, 여기서는 그 이름을 적기만 한다.
# APP_PORT 가 없으면 PORT, INFUSESIGHT_PORT, NEXT_PUBLIC_PORT, 마지막 기본값 3000.
PM2_APP_NAME=infusesight-web-server
APP_PORT=30060
APP_ENTRY=standalone-server.mjs
APP_SERVER_JS=server.js
ARCHIVE_PREFIX=standalone-deploy

SSL_COUNTRY=KR
SSL_STATE=Seoul
SSL_LOCALITY=Ilwon
SSL_ORG=SamsungHospital
SSL_OU=IT Department
SSL_CA_OU=IT
SSL_CN=localhost
SSL_CA_CN=SamsungHospital Root CA
SSL_PFX_NAME=SamsungHospital Hub Server
SSL_DAYS=365
SSL_KEY_BITS=2048
SSL_SAN_DNS=localhost,*.localhost
SSL_SAN_IPS=127.0.0.1,::1,192.148.107.253,192.168.122.21
SSL_INSTALL_ROOT=true
# SSL_VERIFY_URL=https://localhost:30060/

# Recommended for most uses
DATABASEURL="postgresql://tphcadmin:CANal1@127.0.0.1:30500/infusesight?schema=public"

NEXTAUTH_URL=https://localhost:30060
NEXTAUTH_SECRET="cmjNJm4oUm/6Qy1uO1RQ36f9f2wYa8XnTwFYfiNbnDBk="

# 허브 API URL (강제 펌프/처방 연결해제 등). 기본값: http://127.0.0.1:30080
# HUB_API_URL=http://127.0.0.1:30080

# NEXT_PUBLIC_MODALITY_X_API_KEY="7wCAke2GKebL0Thd8Lzwt21HIkxH7xAJ"
INFUSESIGHT_PORT=30060

# BPOC OAuth2 Client Credentials (openssl rand -base64 32 로 생성)
BPOC_CLIENT_ID="smc_bpoc"
BPOC_CLIENT_SECRET="wOsGSlx2XWf+pYRrn/0fq+q98UgBHbva0Lh+7cX+ut8="
BPOC_JWT_SECRET="bc3vmnVnQki6C496mp4eG9WR37i1Y7nk"

NEXT_PUBLIC_HOSPITAL_X_API_KEY="bc3vmnVnQki6C496mp4eG9WR37i1Y7nk"
NEXT_PUBLIC_MODALITY_X_API_KEY="7wCAke2GKebL0Thd8Lzwt21HIkxH7xAJ"
NEXT_PUBLIC_USE_HTTPS=true

NEXT_PUBLIC_INFUSESIGHT_LOGO_IMAGE="/assets/SMC_LOGO.png"
NEXT_PUBLIC_INFUSESIGHT_LOGO_DARK_IMAGE="/assets/SMC_DARK_LOGO.png"
NEXT_PUBLIC_INFUSESIGHT_LOGIN_LOGO_IMAGE="/assets/SMC_LOGO.png"
NEXT_PUBLIC_INFUSESIGHT_HOSPITAL_NAME="삼성서울병원"
NEXT_PUBLIC_INFUSESIGHT_HOSPITAL_ENG_NAME="Samsung Medical Center"
NEXT_PUBLIC_INFUSESIGHT_HOSPITAL_SHORT_NAME="SMC"
NEXT_PUBLIC_INFUSESIGHT_SINCE_YEAR=" "

# SSL 경로: OperatingEnv 사용 시 ecosystem.config.js가 shared/ssl 기준으로 자동 설정
# (환경변수로 덮어쓰지 않으면 shared/ssl 사용)
SSL_KEY_PATH=./ssl/server.key
SSL_CERT_PATH=./ssl/server.crt
SSL_CA_PATH=./ssl/rootCA.crt

INFUSESIGHT_PRODUCT=true
NODE_TLS_REJECT_UNAUTHORIZED=0

# 세션 유효성 주기 검사 (SessionManager). 선택 사항
# 설정 시 숫자(ms), 미설정 시 60000. 병원에서는 300000(5분) 등으로 늘려 테스트.
NEXT_PUBLIC_SESSION_VALIDITY_CHECK_INTERVAL_MS=300000
# 설정 시 true/false, 미설정 시 false. 병원에서는 true로 설정하여 세션 유효성 주기 검사 활성화.
NEXT_PUBLIC_DISABLE_SESSION_VALIDITY_CHECK=true
# 설정 시 숫자(분), 미설정 시 0. 병원에서는 5분 등으로 설정하여 세션 유효성 주기 검사 활성화.
NEXT_PUBLIC_SESSION_VALIDITY_CHECK_IDLE_MINUTES=5

NEXT_PUBLIC_TRUST_ROOT_CA_DOWNLOAD=true
LOG_FORCE_FILE=1

# Winston 별도 파일 로깅 (OperatingEnv: ecosystem에서 LOG_DIR 자동 설정)
# LOG_LEVEL: debug | info | warn | error (당분간 debug, 안정화 후 error)
# LOG_DIR: ecosystem.config.js에서 shared/logs 절대경로로 전달 (env에서 덮어쓰기 가능)
LOG_LEVEL=debug
