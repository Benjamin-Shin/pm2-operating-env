INFUSESIGHT_PRODUCT=true
NODE_TLS_REJECT_UNAUTHORIZED=0

# 세션 유효성 주기 검사 (SessionManager). 선택 사항
# 설정 시 숫자(ms), 미설정 시 60000. 병원에서는 300000(5분) 등으로 늘려 테스트.
NEXT_PUBLIC_SESSION_VALIDITY_CHECK_INTERVAL_MS=300000
# 설정 시 true/false, 미설정 시 false. 병원에서는 true로 설정하여 세션 유효성 주기 검사 활성화.
NEXT_PUBLIC_DISABLE_SESSION_VALIDITY_CHECK=true
# 설정 시 숫자(분), 미설정 시 0. 병원에서는 5분 등으로 설정하여 세션 유효성 주기 검사 활성화.
NEXT_PUBLIC_SESSION_VALIDITY_CHECK_IDLE_MINUTES=5

NEXT_PUBLIC_TRUST_ROOT_CA_DOWNLOAD=true
LOG_FORCE_FILE=1

# Winston 별도 파일 로깅 (OperatingEnv: ecosystem에서 LOG_DIR 자동 설정)
# LOG_LEVEL: debug | info | warn | error (당분간 debug, 안정화 후 error)
# LOG_DIR: ecosystem.config.js에서 shared/logs 절대경로로 전달 (env에서 덮어쓰기 가능)
LOG_LEVEL=debug